# ==============================================================================
# 🌸 KAZUMI DISCORD AI COMPANION — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# Never commit your real .env file with secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD BOT CREDENTIALS (REQUIRED)
# Obtain from: https://discord.com/developers/applications
# Enable: Server Members Intent & Message Content Intent under Bot tab.
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=

# Optional: Restrict Kazumi's primary listening channel (leave blank for all channels)
DISCORD_CHANNEL_ID=

# Command prefix for text commands (default: !k )
PREFIX=!k 
DISCORD_PREFIX=!k 

# ------------------------------------------------------------------------------
# 2. AI / LLM CREDENTIALS (REQUIRED FOR AI CHAT & VISION OCR)
# Primary provider is OpenAI (paid API key). Set OPENAI_API_KEY.
# API_KEY is supported as a legacy alias with deprecation warning.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
API_KEY=

# Optional fallback provider
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. CLOUD HOSTING & TELEMETRY (BOT-HOSTING / RENDER / DOCKER)
# Web server checks GET /health on PORT (default: 10000).
# ------------------------------------------------------------------------------
PORT=10000

# ------------------------------------------------------------------------------
# 4. PERSISTENT STORAGE
# Defaults to ./isa_memory or /app/isa_memory inside Docker containers.
# ------------------------------------------------------------------------------
ISA_MEMORY_DIR=

# ------------------------------------------------------------------------------
# 5. CREATOR & ADMIN IDENTIFIERS (OPTIONAL)
# Comma-separated Discord User IDs for special companion lore recognition
# e.g. CREATOR_USER_IDS=123456789012345678,987654321098765432
# ------------------------------------------------------------------------------
CREATOR_USER_IDS=
AAMIR_USER_IDS=
SHAN_USER_IDS=
